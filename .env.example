# Copy to .env.production only through scripts/bootstrap_credentials.sh. Compose reads this file
# with `docker compose --env-file .env.production ...`; it is ignored by Git.
MIZAN_IMAGE=mizan-control-plane:local
MIZAN_HTTPS_PORT=8443

# Generated by bootstrap_credentials.sh. Never commit the generated values.
MIZAN_POSTGRES_OWNER_PASSWORD=__GENERATED_OWNER_PASSWORD__
MIZAN_APP_PASSWORD=__GENERATED_APP_PASSWORD__

# Customer identity provider. Keep the JWKS public-only and on one line.
MIZAN_JWT_ISSUER=https://idp.customer.example
MIZAN_JWT_AUDIENCE=mizan-control-plane
MIZAN_IDENTITY_JWKS={"keys":[]}

# Customer workforce OIDC. The secret is mounted from the credential layout, never exposed to JS.
MIZAN_WORKFORCE_OIDC_AUTHORIZATION_ENDPOINT=https://idp.customer.example/authorize
MIZAN_WORKFORCE_OIDC_TOKEN_ENDPOINT=https://idp.customer.example/token
MIZAN_WORKFORCE_OIDC_CLIENT_ID=mizan-console
MIZAN_WORKFORCE_OIDC_CLIENT_SECRET_FILE=/run/mizan/secrets/workforce-oidc-client-secret
MIZAN_WORKFORCE_OIDC_REDIRECT_URI=https://mizan.customer.example/auth/callback
MIZAN_WORKFORCE_TENANT_ID=tnt_replace-me
MIZAN_WORKFORCE_GROUP_CLAIM=groups
MIZAN_WORKFORCE_ROLE_MAPPING={"customer-ops":{"roles":["manager"],"control_domain":"operations"},"customer-risk":{"roles":["risk"],"control_domain":"risk"}}
MIZAN_WORKFORCE_SESSION_TTL_SECONDS=900
MIZAN_WORKFORCE_STEP_UP_MAX_AGE_SECONDS=120
MIZAN_WORKFORCE_STEP_UP_ACR_VALUES=urn:mizan:hardware,urn:mizan:mfa

# Existing, customer-operated Vault Transit endpoint. The runtime token is mounted from
# secrets/runtime/vault-token, not placed in this file.
MIZAN_VAULT_ADDR=https://vault.customer.example:8200
MIZAN_VAULT_CA_CERT=/run/mizan/tls/vault-ca.pem

# RFC 3161 is mandatory in production. tsa-root.pem is supplied by the chosen authority.
MIZAN_ANCHOR_TSA_ENDPOINTS=https://tsa.customer.example
MIZAN_EXECUTION_TOKEN_ISSUER=https://mizan.customer.example/execution
MIZAN_EVALUATOR_BUILD=replace-with-release-identifier
MIZAN_EVALUATOR_CONFIGURATION_HASH=replace-with-64-lowercase-hex-characters

# The bucket must be created with Object Lock; provision_object_store.py verifies this.
MIZAN_AUDIT_ANCHOR_BUCKET=mizan-evidence-production
MIZAN_S3_ENDPOINT_URL=https://s3.customer.example
MIZAN_S3_REGION=us-east-1
MIZAN_S3_ACCESS_KEY_ID=replace-with-runtime-access-key
MIZAN_S3_SECRET_ACCESS_KEY=replace-with-runtime-secret-key

# Explicit served tenants preserve FORCE RLS. A worker with no tenant list refuses to start.
MIZAN_DRAIN_TENANTS=tnt_replace-me
MIZAN_ATTEST_TENANTS=tnt_replace-me

# Directories produced by bootstrap_credentials.sh.
MIZAN_TLS_DIRECTORY=./secrets/tls
MIZAN_SECRET_DIRECTORY=./secrets/runtime
